# =================================================================================================
# NEVIX — environment template
# =================================================================================================
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed
# (specification §25, instruction §45).
#
# Generate every secret with:
#     ./scripts/generate-secrets.sh
#
# The API refuses to start in production when SECRET_KEY is short, DEBUG is true, CORS_ORIGINS
# contains "*", or DATABASE_URL still holds the development credentials. That is deliberate: a
# misconfigured production process should fail loudly at startup rather than run insecurely.
# =================================================================================================

# -------------------------------------------------------------------------------------------------
# Application
# -------------------------------------------------------------------------------------------------

# local | development | staging | production
APP_ENV=production

# Must be false in production. Enabling it exposes stack traces.
DEBUG=false

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Docker image tag used by docker compose. Set to a commit SHA in CI for reproducible deploys.
IMAGE_TAG=latest


# -------------------------------------------------------------------------------------------------
# Public URLs
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time, not read at runtime.
# Changing one requires rebuilding the web image.
# -------------------------------------------------------------------------------------------------

# Canonical site origin. Used for canonical URLs, the sitemap and OpenGraph metadata.
NEXT_PUBLIC_SITE_URL=https://nevix.ai

# Path the browser uses to reach the backend. Defaults to the same-origin Next.js proxy, which is
# what keeps `connect-src 'self'` intact in the Content Security Policy.
NEXT_PUBLIC_API_URL=/api/backend

# local | development | staging | production.
# Anything other than "production" makes robots.txt disallow all crawling, so a staging site
# cannot be indexed alongside the real one.
NEXT_PUBLIC_ENV=production


# -------------------------------------------------------------------------------------------------
# Secrets — generate these, never reuse them between environments
# -------------------------------------------------------------------------------------------------

# Signing and IP-hashing key for the API. At least 32 characters.
#   openssl rand -base64 48
SECRET_KEY=

# Bearer token for /api/v1/admin/*. Leave EMPTY to disable the admin API entirely — an absent key
# means the endpoints return 404, never "no authentication required".
#   openssl rand -base64 48
ADMIN_API_KEY=


# -------------------------------------------------------------------------------------------------
# Database
#
# PostgreSQL is never published to the host in production (specification §76). These credentials
# are used by the API, the CMS and the backup job.
# -------------------------------------------------------------------------------------------------

POSTGRES_USER=nevix
POSTGRES_PASSWORD=
POSTGRES_DB=nevix

# Strapi uses a separate database on the same server, created by
# infra/docker/postgres/init/01-create-cms-database.sh.
CMS_DATABASE_NAME=nevix_cms

# Set to "false" when several API replicas start together and a separate job owns migrations, so
# concurrent `alembic upgrade` runs cannot race.
RUN_MIGRATIONS=true


# -------------------------------------------------------------------------------------------------
# Content source (see docs/architecture/adr/ADR-006-content-provider-abstraction.md)
# -------------------------------------------------------------------------------------------------

# local  — serve the typed content committed in apps/web/content (no CMS required)
# strapi — read from the running Strapi instance
CONTENT_PROVIDER=local

CMS_URL=https://cms.nevix.ai

# READ-ONLY Strapi API token. Create it in the Strapi admin under Settings → API Tokens with
# "Read-only" access. A full-access token here would let a frontend bug modify content.
CMS_API_TOKEN=

# ISR revalidation window, in seconds.
CONTENT_REVALIDATE_SECONDS=3600


# -------------------------------------------------------------------------------------------------
# CMS secrets — Strapi refuses to start without these
#   openssl rand -base64 32   (APP_KEYS needs four, comma separated)
# -------------------------------------------------------------------------------------------------

CMS_APP_KEYS=
CMS_API_TOKEN_SALT=
CMS_ADMIN_JWT_SECRET=
CMS_TRANSFER_TOKEN_SALT=
CMS_JWT_SECRET=


# -------------------------------------------------------------------------------------------------
# CORS (specification §75)
#
# Comma separated. Leave EMPTY when the website calls through the same-origin proxy, which is the
# default. "*" is rejected at startup.
# -------------------------------------------------------------------------------------------------

CORS_ORIGINS=


# -------------------------------------------------------------------------------------------------
# Rate limiting
# -------------------------------------------------------------------------------------------------

RATE_LIMIT_ENABLED=true

# Optional Redis backing so limits are shared across API replicas. Without it each replica keeps
# its own in-memory counters, so the effective limit multiplies by the replica count.
# Requires the "cache" compose profile.
# RATE_LIMIT_STORAGE_URI=redis://:PASSWORD@redis:6379/1


# -------------------------------------------------------------------------------------------------
# Email (instruction §72)
#
# Leave SMTP_HOST empty to disable notifications. Enquiries are still recorded and the visitor
# still gets a confirmation — the response simply reports notification_sent: false.
# -------------------------------------------------------------------------------------------------

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

EMAIL_FROM=no-reply@nevix.ai

# Where new enquiry notifications are delivered.
EMAIL_NOTIFY_TO=


# -------------------------------------------------------------------------------------------------
# Public site details, exposed by GET /api/v1/site-config
#
# DUMMY-DATA: DD-004 — replace with verified contact details before launch.
# -------------------------------------------------------------------------------------------------

SITE_CONTACT_EMAI= nevix.ai@gmail.com
SITE_PHONE= +91 9552334155
SITE_ADDRESS= Pune, Maharashtra, India


# -------------------------------------------------------------------------------------------------
# Optional services — profile-gated, not used by the MVP (ADR-008)
# -------------------------------------------------------------------------------------------------

# Redis — `docker compose --profile cache up -d`
# REDIS_PASSWORD=
# REDIS_MAXMEMORY=256mb

# MinIO object storage — `docker compose --profile storage up -d`
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=
# MINIO_CONSOLE_URL=https://storage.nevix.ai

# Monitoring — docker compose -f docker-compose.yml -f docker-compose.monitoring.yml up -d
# Grafana is never exposed publicly (instruction §48).
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=
# GLITCHTIP_SECRET_KEY=
