{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": "A NEVIX product. Status must reflect reality (specification §9.1)."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 120
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "tagline": {
      "type": "string",
      "maxLength": 200
    },
    "status": {
      "type": "enumeration",
      "enum": ["concept", "prototype", "beta", "live", "coming-soon"],
      "default": "concept",
      "required": true
    },
    "summary": {
      "type": "text",
      "required": true
    },
    "heroTitle": {
      "type": "string",
      "required": true,
      "maxLength": 200
    },
    "heroDescription": {
      "type": "text",
      "required": true
    },
    "problem": {
      "type": "richtext",
      "required": true
    },
    "plannedCapabilities": {
      "type": "json"
    },
    "services": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::service.service"
    },
    "icon": {
      "type": "string",
      "maxLength": 40
    },
    "isPlaceholder": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
